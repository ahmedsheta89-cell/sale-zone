{
  "name": "sale-zone-governance",
  "version": "1.0.0",
  "private": true,
  "description": "Governance entrypoints for Sale Zone root checks",
  "type": "commonjs",
  "scripts": {
    "preflight": "node tools/codex-preflight.js",
    "governance": "node tools/verify-branch-protection.js",
    "health": "node tools/smoke-check.js && node tools/contracts-check.js && node tools/admin-function-monitor.js",
    "smoke": "node tools/smoke-check.js",
    "contracts": "node tools/contracts-check.js",
    "monitor": "node tools/admin-function-monitor.js",
    "test:emulator:rules": "node tools/run-emulator-suite.js --only-rules",
    "test:emulator:e2e": "node tools/run-emulator-suite.js --only-e2e",
    "test:emulator": "node tools/run-emulator-suite.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.58.2",
    "acorn": "^8.16.0",
    "astring": "^1.9.0",
    "firebase-admin": "^14.5.1",
    "parse5": "^8.0.0",
    "playwright": "^1.58.2"
  }
}
